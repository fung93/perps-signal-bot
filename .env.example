# Perps Signal Bot — environment variables (names only; never commit real values).
# Copy to .env for local dev. In GitHub Actions, set these as repository secrets.

# Neon (serverless Postgres) — use the POOLED connection string (host contains "-pooler").
# Example shape:
# postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
NEON_DATABASE_URL=

# Telegram Bot API — token from @BotFather, and the chat id to send to.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: force a single Binance market-data host. Leave unset to use the default
# order (data-api.binance.vision, then api.binance.com).
# BINANCE_API_BASE=https://data-api.binance.vision

# Operational controls (optional). KILL_SWITCH=true halts all signal emission;
# MAX_SIGNALS_PER_DAY caps tradeable signals per UTC day (default 3).
# KILL_SWITCH=
# MAX_SIGNALS_PER_DAY=3
